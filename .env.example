
# Database
DATABASE_URL=postgresql://user:password@host:port/database

# ONDC Network Configuration
ONDC_BAP_ID=your-bap-id.ondc.org
ONDC_BAP_URI=https://your-domain.com/
ONDC_SUBSCRIBER_ID=your-subscriber-id
ONDC_UNIQUE_KEY_ID=your-unique-key-id

# ONDC Signing Keys (Ed25519)
ONDC_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYour_Private_Key_Here\n-----END PRIVATE KEY-----
ONDC_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nYour_Public_Key_Here\n-----END PUBLIC KEY-----

# ONDC Gateway
ONDC_GATEWAY_TOKEN=your-gateway-token
NODE_ENV=development

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Maps Integration (Mappls)
MAPPLS_CLIENT_ID=your_mappls_client_id
MAPPLS_CLIENT_SECRET=your_mappls_client_secret
MAPPLS_API_KEY=your_mappls_api_key

# Firebase Authentication
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# SMS Gateway (Airtel DLT)
AIRTEL_DLT_API_KEY=your_airtel_dlt_key
AIRTEL_DLT_SENDER_ID=your_sender_id
AIRTEL_DLT_TEMPLATE_ID=your_template_id

# Language Translation (Bhashini)
BHASHINI_API_KEY=your_bhashini_key
BHASHINI_USER_ID=your_user_id

# Ticketing System (Bugzilla)
BUGZILLA_URL=https://your-bugzilla-instance.com
BUGZILLA_API_KEY=your_bugzilla_api_key

# Session Secret
SESSION_SECRET=your-session-secret-change-this-in-production

# Application URLs
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:5000

# RabbitMQ (Optional - for async operations)
RABBITMQ_URL=amqp://localhost:5672

# Elasticsearch (Optional - for enhanced search)
ELASTICSEARCH_URL=http://localhost:9200

# MongoDB (Optional - for ONDC transaction logs)
MONGODB_URL=mongodb://localhost:27017/ondc_logs
